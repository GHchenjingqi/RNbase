{
  "name": "cammer.qux",
  "version": "1.2.2",
  "private": true,
  "scripts": {
    "emulator": "node scripts/emulator.js",
    "dev": "node scripts/dev.js",
    "stop": "node scripts/stop.js",
    "app:show": "node scripts/use-app.js",
    "app:use": "node scripts/use-app.js",
    "brand:apply": "node scripts/apply-app-meta.js",
    "brand:gen": "node scripts/gen-brand.js",
    "build:android:install": "node scripts/gradle.js installDebug",
    "build:android": "node scripts/gradle.js assembleDebug",
    "build:android:release": "node scripts/gradle.js assembleRelease",
    "clean:android": "node scripts/gradle.js clean",
    "version:show": "node scripts/bump-version.js show",
    "version:bump": "node scripts/bump-version.js patch",
    "version:bump:patch": "node scripts/bump-version.js patch",
    "version:bump:minor": "node scripts/bump-version.js minor",
    "version:bump:major": "node scripts/bump-version.js major",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"*.{ts,tsx,js}\" \"scripts/*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"*.{ts,tsx,js}\" \"scripts/*.js\"",
    "test": "jest",
    "sync:api": "node scripts/sync-h5-api.js",
    "ios": "react-native run-ios"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.87.1",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "hermes-compiler": "^250829098.0.17",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}

{
  "name": "rn-base",
  "version": "1.2.2",
  "private": true,
  "description": "RN + WebView + H5 混合架构基座（Native Container + Bridge 能力边界），能力测试子应用见 RN_h5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GHchenjingqi/RNbase.git"
  },
  "homepage": "https://github.com/GHchenjingqi/RNbase",
  "scripts": {
    "dev": "node scripts/dev.js",
    "emulator": "node scripts/emulator.js",
    "stop": "node scripts/stop.js",
    "app:show": "node scripts/use-app.js",
    "app:use": "node scripts/use-app.js",
    "brand:apply": "node scripts/apply-app-meta.js",
    "brand:reset": "node scripts/apply-app-meta.js --reset",
    "brand:gen": "node scripts/gen-brand.js",
    "emulator:android": "node scripts/emulator.js",
    "dev:android": "node scripts/dev.js",
    "build:android:install": "node scripts/gradle.js installDebug",
    "build:android": "node scripts/gradle.js assembleDebug",
    "build:android:release": "node scripts/gradle.js assembleRelease",
    "clean:android": "node scripts/gradle.js clean",
    "emulator:harmony": "node scripts/harmony-emulator.js",
    "dev:harmony": "node scripts/harmony-dev.js",
    "build:harmony": "node scripts/hvigor.js assembleHap",
    "build:harmony:release": "node scripts/hvigor.js assembleHap --release",
    "install:harmony": "node scripts/hvigor.js assembleHap --install",
    "clean:harmony": "node scripts/hvigor.js clean",
    "ios:doctor": "node scripts/ios.js doctor",
    "ios:sync-h5": "node scripts/ios-sync-h5.mjs",
    "ios:pods": "node scripts/ios.js pods",
    "dev:ios": "node scripts/ios.js run",
    "build:ios": "node scripts/ios.js build",
    "build:ios:release": "node scripts/ios.js build --release",
    "version:show": "node scripts/bump-version.js show",
    "version:bump": "node scripts/bump-version.js patch",
    "version:bump:patch": "node scripts/bump-version.js patch",
    "version:bump:minor": "node scripts/bump-version.js minor",
    "version:bump:major": "node scripts/bump-version.js major",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"*.{ts,tsx,js}\" \"scripts/*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"*.{ts,tsx,js}\" \"scripts/*.js\"",
    "test": "jest",
    "sync:api": "node scripts/sync-h5-api.js",
    "doctor": "node scripts/doctor.js",
    "doctor:hermesc": "node scripts/check-hermesc.js",
    "apk:hash": "node scripts/apk-hash.js",
    "gen:api-doc": "node scripts/gen-api-doc.js",
    "gen:api-doc:check": "node scripts/gen-api-doc.js --check"
  },
  "dependencies": {
    "@react-native-oh/react-native-harmony": "^0.84.4",
    "@react-native-ohos/react-native-safe-area-context": "^5.6.4",
    "@react-native-ohos/react-native-webview": "^13.16.3-rc.3",
    "@react-native/new-app-screen": "0.84.1",
    "react": "^19.2.3",
    "react-native": "0.84.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native-oh/react-native-harmony-cli": "^0.84.4",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "hermes-compiler": "250829098.0.9",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}

#!/usr/bin/env sh
# RNbase 提交前检查（P0-4 韧性地基 · Git Hooks）。
#
# 仅使用仓库已安装的 eslint / prettier / tsc，不引入新依赖，
# 因此不会破坏现有 npm ci（不修改 package.json / package-lock.json）。
#
# 激活方式（二选一）：
#   1) 用 husky：npm i -D husky lint-staged && npx husky install
#   2) 不用 husky：cp .husky/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# 完整校验（typecheck / lint 全量 / prettier 全量 / jest）交给 CI，
# 提交钩子只挡「暂存区的明显问题」，保持提交快。

# husky 注入的辅助脚本（若存在则 source，不存在也不影响）
HUSSKY_SH="$(dirname -- "$0")/_/husky.sh"
if [ -f "$HUSSKY_SH" ]; then
  . "$HUSSKY_SH"
fi

ROOT="$(git rev-parse --show-toplevel)"

# 暂存区中的 TS/TSX（测试由 CI 的 jest 覆盖，这里不拦，避免误伤）
STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$' || true)

if [ -n "$STAGED" ]; then
  echo "[pre-commit] eslint 检查暂存文件"
  # 逐个跑：eslint 8 没有 --no-warn-ignored，把 .eslintignore 里的路径（platforms/、coverage/ 等）
  # 直接当参数传会报"File ignored…"+超预算警告而退 1，
  # 那类文件本来就不入 lint 范围，跳过而不是让提交无故红。
  for F in $STAGED; do
    OUT=$(npx eslint --max-warnings=0 -- "$F" 2>&1)
    if [ $? -ne 0 ]; then
      case "$OUT" in
        *"File ignored because of a matching ignore pattern"*) continue ;;
      esac
      echo "$OUT"
      exit 1
    fi
  done
fi

# 暂存区中的源码做 prettier 自动格式化（向前约束，不卡存量文件）
STAGED_FMT=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js)$' || true)

if [ -n "$STAGED_FMT" ]; then
  echo "[pre-commit] prettier 格式化暂存文件"
  echo "$STAGED_FMT" | xargs -I{} npx prettier --write "{}"
  echo "$STAGED_FMT" | xargs -I{} git add "{}"
fi

# 基座品牌中性守卫：只有本次提交碰了「下发会写的仓库可见路径」才跑。
# 判的是工作区状态（够用且便宜）：这些路径是子应用品牌的落点，碰了就说明这次提交
# 有可能把某个具体 App 的名字/底色/图标带进基座历史；CI 会对 checkout 出来的提交再查一遍。
STAGED_BRAND=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(src/main/(res|brand-default)/|harmony/(AppScope|entry/src/main)/resources/.*string\.json$)' || true)

if [ -n "$STAGED_BRAND" ]; then
  echo "[pre-commit] 基座品牌中性检查"
  node scripts/check-brand-neutral.js || {
    echo "[pre-commit] 复位命令：npm run brand:reset（会同时把 version.json 的版本号打回 1.0.0/1）"
    exit 1
  }
fi

echo "[pre-commit] OK"
